{
  "name": "ocforge-test",
  "version": "0.1.0",
  "private": true,
  "description": "Scratch extension for the end-to-end check of oc-forge's OpenChamber adapters: key forwarding, deep links and printing (ocForge.modals).",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.2"
    },
    "contributes": {
      "panel": {
        "id": "ocforge-test",
        "name": "oc-forge test",
        "icon": "flask",
        "entry": "panel/index.html"
      },
      "page": {
        "entry": "panel/index.html",
        "title": "oc-forge test"
      },
      "capabilities": ["sessions"]
    }
  },
  "ocForge": {
    "apiVersion": 1,
    "modals": true
  }
}
