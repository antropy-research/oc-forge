{
  "name": "@oc-forge/openchamber-planner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Sunsama-style daily planning inside OpenChamber.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.4.0"
    },
    "contributes": {
      "panel": {
        "id": "oc-forge-planner",
        "name": "Planner",
        "icon": "calendar-event",
        "entry": "panel/index.html"
      },
      "page": true,
      "capabilities": [
        "sessions"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "git"
          ]
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p .",
    "test": "bun test tests/",
    "build": "bun run build:panel && bun run build:service",
    "build:panel": "openchamber-guest-bundle panel/main.tsx panel/main.js",
    "build:service": "openchamber-guest-bundle --node service/main.ts service/main.js"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.4.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "preact": "^11.0.2"
  }
}
