{
  "name": "@oc-forge/openchamber-vscode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VS Code inside OpenChamber: VS Code's editor and highlighting for code files, and the VS Code Server for the folder at hand.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.1"
    },
    "contributes": {
      "panel": {
        "id": "oc-forge-vscode",
        "name": "VS Code",
        "icon": "code-box",
        "entry": "panel/index.html"
      },
      "background": {
        "entry": "panel/index.html"
      },
      "actions": [
        {
          "id": "open-in-vscode",
          "label": "Open in VS Code",
          "icon": "code-box",
          "where": "session",
          "mode": "background"
        }
      ],
      "fileEditors": [
        {
          "id": "web",
          "title": "VS Code",
          "match": [
            "*.ts",
            "*.tsx",
            "*.mts",
            "*.cts",
            "*.js",
            "*.jsx",
            "*.mjs",
            "*.cjs",
            "*.css",
            "*.scss",
            "*.less",
            "*.hbs",
            "*.handlebars",
            "*.pug"
          ],
          "entry": "editor/index.html"
        },
        {
          "id": "systems",
          "title": "VS Code",
          "match": [
            "*.c",
            "*.h",
            "*.cc",
            "*.cpp",
            "*.cxx",
            "*.hpp",
            "*.hh",
            "*.cs",
            "*.go",
            "*.rs",
            "*.java",
            "*.swift",
            "*.m",
            "*.mm",
            "*.cu",
            "*.dart"
          ],
          "entry": "editor/index.html"
        },
        {
          "id": "scripts",
          "title": "VS Code",
          "match": [
            "*.py",
            "*.pyi",
            "*.rb",
            "*.php",
            "*.pl",
            "*.pm",
            "*.lua",
            "*.r",
            "*.jl",
            "*.ps1",
            "*.psm1",
            "*.sh",
            "*.bash",
            "*.zsh",
            "*.groovy",
            "*.gradle"
          ],
          "entry": "editor/index.html"
        },
        {
          "id": "more",
          "title": "VS Code",
          "match": [
            "*.fs",
            "*.fsx",
            "*.clj",
            "*.cljs",
            "*.coffee",
            "*.vb",
            "*.sql",
            "*.bat",
            "*.cmd",
            "*.raku",
            "*.hlsl",
            "*.shader",
            "*.tex",
            "*.bib",
            "*.rst",
            "*.wat"
          ],
          "entry": "editor/index.html"
        },
        {
          "id": "config",
          "title": "VS Code",
          "match": [
            "*.yaml",
            "*.yml",
            "*.xml",
            "*.xsl",
            "*.ini",
            "*.properties",
            "*.cfg",
            ".env",
            "*.env",
            "Dockerfile",
            "*.dockerfile",
            "Makefile",
            "*.mk",
            "*.diff",
            "*.patch",
            ".gitignore"
          ],
          "entry": "editor/index.html"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc -p .",
    "build": "bun scripts/build.ts",
    "collect": "bun scripts/collect-vscode.ts",
    "test": "bun test tests/"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.5.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "monaco-editor": "0.57.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
