{
  "name": "openchamber-bridge",
  "publisher": "openchamber",
  "displayName": "OpenChamber Bridge",
  "description": "Makes VS Code's parts in OpenChamber (the rail view, the page, the bottom terminal) one VS Code: one debugger, one list of terminals and tasks, one Problems list. OpenChamber's VS Code extension installs it on the server it connects to.",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./main.js",
  "activationEvents": [
    "onStartupFinished",
    "onDebug",
    "onCommand:workbench.action.terminal.new",
    "onCommand:workbench.action.terminal.newWithProfile",
    "onCommand:workbench.action.terminal.newInActiveWorkspace",
    "onCommand:workbench.action.terminal.split",
    "onCommand:workbench.action.terminal.toggleTerminal",
    "onCommand:workbench.action.terminal.focus",
    "onCommand:workbench.action.terminal.runSelectedText",
    "onCommand:workbench.action.terminal.runActiveFile",
    "onCommand:workbench.action.tasks.reRunTask",
    "onCommand:workbench.action.tasks.restartTask",
    "onCommand:workbench.action.tasks.terminate",
    "onCommand:workbench.action.tasks.showTasks",
    "onCommand:workbench.action.tasks.showLog"
  ],
  "contributes": {
    "debuggers": [
      {
        "type": "openchamber-mirror",
        "label": "OpenChamber",
        "hiddenWhen": "true"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "openchamber.outline",
          "name": "Outline",
          "when": "openchamber.bridge.part == view"
        },
        {
          "id": "openchamber.timeline",
          "name": "Timeline",
          "when": "openchamber.bridge.part == view"
        }
      ]
    }
  }
}
